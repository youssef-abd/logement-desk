    "leboncoin": {"enabled": true, "city": "<city>", "lat": 0.0, "lng": 0.0, "radius_m": 6000, "limit": 35, "max_square": 60},
    "lacartedescolocs": {"enabled": false, "url": "<list-page-url>"},
